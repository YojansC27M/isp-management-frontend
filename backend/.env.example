CLIENT_PORTAL_BASE_URL=http://localhost:5173/client
BILLING_AUTOMATION_ENABLED=true
BILLING_AUTOMATION_INTERVAL_MINUTES=60
BILLING_CUT_DAY=5
BILLING_DUE_DAYS=10
