APP_NAME="ISP Management API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
PORT=8001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/isp_management"
JWT_SECRET="change-me"
APP_ENCRYPTION_KEY="change-me-32-bytes-minimum"
JWT_EXPIRES_IN="1d"
BOOTSTRAP_ADMIN_EMAIL="admin@isp.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
BOOTSTRAP_ADMIN_NAME="System Admin"

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
MIKROTIK_HOST=192.168.56.2
MIKROTIK_PORT=80
MIKROTIK_USER=apiuser
MIKROTIK_PASSWORD=change-me
MIKROTIK_MODE=live
MIKROTIK_USE_SSL=false
MIKROTIK_TLS_REJECT_UNAUTHORIZED=false
MONITORING_TRAFFIC_SAMPLING_MS=60000
